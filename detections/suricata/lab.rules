# Lab-only Suricata rules for the WAN-side scan demo.
# Run manually on OPNsense vtnet1; not the production OPNsense IDS ruleset.

alert tcp 192.168.50.10 any -> 10.0.0.5 any (msg:"LAB WAN scan to target"; flags:S; sid:1000001; rev:1;)
alert tcp 192.168.50.10 any -> 192.168.50.1 any (msg:"LAB WAN scan to firewall"; flags:S; sid:1000002; rev:1;)
alert icmp 192.168.50.10 any -> any any (msg:"LAB WAN ping"; itype:8; sid:1000003; rev:1;)
