<!-- SOC-LAB Custom Detection Rules -->

<group name="local,windows,sysmon,soc_lab,">

  <!--
    SOC-LAB Registry Run Key Detection
    Parent: Wazuh Sysmon rule 92300
    MITRE ATT&CK:
      T1112    - Modify Registry
      T1547.001 - Registry Run Keys / Startup Folder
  -->

  <rule id="100501" level="7">
    <if_sid>92300</if_sid>
    <description>SOC Lab: Registry Run Key modification detected - $(win.eventdata.targetObject)</description>
    <mitre>
      <id>T1112</id>
      <id>T1547.001</id>
    </mitre>
  </rule>

  <!--
    SOC-LAB WinRM Remote Process Detection
    Parent: Wazuh Sysmon rule 92052
    MITRE ATT&CK: T1021.006 - Windows Remote Management
  -->
  <rule id="100502" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)wsmprovhost\.exe$</field>
    <description>SOC Lab: Process spawned via Windows Remote Management (WinRM) - $(win.eventdata.image) by $(win.eventdata.user)</description>
    <mitre>
      <id>T1021.006</id>
    </mitre>
</rule>

  <!--
    SOC-LAB Repeated Windows Failed Logon Detection
    Parent: Wazuh rule 60122
    Trigger: 5 failed logons within 60 seconds
    MITRE ATT&CK: T1110 - Brute Force
  -->
  <rule id="100503" level="10" frequency="5" timeframe="60">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>SOC Lab: Repeated Windows failed logons detected for account $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>


  <!--
    SOC-LAB Encoded PowerShell Command Detection
    Source: Sysmon Event ID 1 - Process Create
    Condition:
      - powershell.exe process
      - command line contains -EncodedCommand or -enc
    MITRE ATT&CK: T1059.001 - PowerShell
  -->
  <rule id="100504" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:-EncodedCommand|-enc(?:\s|$))</field>
    <description>SOC Lab: Encoded PowerShell command detected - $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>


  <!--
    SOC-LAB PowerShell Outbound Network Detection
    Source: Sysmon Event ID 3 - Network Connection
    Lab condition:
      - powershell.exe
      - TCP connection initiated by endpoint
      - destination 192.168.50.30:55000
    MITRE ATT&CK: T1095 - Non-Application Layer Protocol
  -->
  <rule id="100505" level="7">
    <if_sid>92101</if_sid>
    <field name="win.eventdata.initiated">^true$</field>
    <field name="win.eventdata.destinationIp">^192\.168\.50\.30$</field>
    <field name="win.eventdata.destinationPort">^55000$</field>
    <description>SOC Lab: PowerShell initiated TCP connection to $(win.eventdata.destinationIp):$(win.eventdata.destinationPort) by $(win.eventdata.user)</description>
    <mitre>
      <id>T1095</id>
    </mitre>
  </rule>
  <!-- Tuning: Reduce severity for legitimate Edge WebView2 unpacking in Temp folders -->
  <rule id="100001" level="3">
    <if_sid>92213</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\+Program Files \(x86\)\\+Microsoft\\+EdgeWebView\\+Application\\+[0-9]+(?:\.[0-9]+){3}\\+msedgewebview2\.exe$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)^C:\\+Users\\+[^\\]+\\+AppData\\+Local\\+Temp\\+msedge_chrome_Unpacker_BeginUnzipping[0-9]+_[0-9]+\\+Microsoft\.CognitiveServices\.Speech\.core\.dll$</field>
    <description>Reduced severity: WebView2 Speech DLL unpacking pattern; benign intent requires triage</description>
  </rule>

</group>
